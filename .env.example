# Database
DATABASE_PATH=./data/app.db

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Panel (comma-separated emails, REQUIRED — if empty, admin panel is disabled)
ADMIN_EMAILS=

# Logto (auth). Values live in the gitignored .env, sourced from the pass vault.
# App creds: pass show cancer-card/logto-app-id | -app-secret (prod)
#            pass show cancer-card/logto-dev-app-id | -dev-app-secret (dev)
LOGTO_ENDPOINT=https://auth.serendipitylabs.cloud
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_BASE_URL=http://localhost:3000
# Random 32+ byte secret for the Logto session cookie: openssl rand -base64 32
LOGTO_COOKIE_SECRET=
# Management API (account deletion). pass show logto/mgmt-api-client-id | -client-secret
LOGTO_MGMT_APP_ID=
LOGTO_MGMT_APP_SECRET=
